generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum LocationScope {
  NATIONAL
  PROVINCE
  CITY
  ADDRESS
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModerationAction {
  APPROVE
  REJECT
}

enum TopicTypeKind {
  PRIMARY
  SECONDARY
}

enum ContactPlatform {
  INSTAGRAM
  TELEGRAM
  WHATSAPP
  BALE
  EITAA
  RUBIKA
  LINKEDIN
  X
  YOUTUBE
  FACEBOOK
  WEBSITE
  OTHER
  PHONE
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  phoneNumber   String    @unique
  displayName   String?
  phoneVerified Boolean   @default(false)
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions       Session[]
  topics         Topic[]
  comments       Comment[]
  submissions    Submission[]
  moderationLogs ModerationLog[]
}

/**
 * Server-recognized session. The browser holds an opaque random token in an
 * HttpOnly cookie; only its SHA-256 hash is stored here, so a DB leak never
 * exposes usable sessions. Expiry is enforced at lookup time.
 */
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Province {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique
  slug String @unique

  cities City[]
  topics Topic[]

  @@index([name])
  @@index([slug])
}

model City {
  id         String @id @default(uuid()) @db.Uuid
  provinceId String @db.Uuid
  name       String
  slug       String

  province Province @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  topics   Topic[]

  @@unique([provinceId, name])
  @@unique([provinceId, slug])
  @@index([provinceId])
  @@index([name])
  @@index([slug])
  @@index([provinceId, name])
}

/**
 * A "page" — the central object of the application. The model keeps its
 * legacy name `Topic` to avoid a disruptive rename; UI copy refers to it as
 * a page.
 *
 * FUTURE OWNERSHIP: `submittedById` is currently unused (no auth). It is the
 * natural home for the future Creator and Owner relations — no schema change
 * is required to add ownership later.
 */
model Topic {
  id            String           @id @default(uuid()) @db.Uuid
  slug          String           @unique
  name          String
  description   String?
  workingHours  String?
  imageUrl      String?
  scope         LocationScope    @default(NATIONAL)
  provinceId    String?          @db.Uuid
  cityId        String?          @db.Uuid
  address       String?
  latitude      Float?
  longitude     Float?
  status        ModerationStatus @default(PENDING)
  submittedById String?          @db.Uuid
  createdAt     DateTime         @default(now())
  approvedAt    DateTime?

  province    Province? @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  city        City?     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  submittedBy User?     @relation(fields: [submittedById], references: [id], onDelete: SetNull)

  types          TopicTypeTag[]
  links          TopicLink[]
  comments       Comment[]
  submission     Submission?
  moderationLogs ModerationLog[]

  @@index([status, createdAt])
  @@index([scope])
  @@index([provinceId])
  @@index([name])
  @@index([createdAt])
  @@index([submittedById])
}

model Comment {
  id           String           @id @default(uuid()) @db.Uuid
  topicId      String           @db.Uuid
  body         String
  status       ModerationStatus @default(PENDING)
  authorId     String?          @db.Uuid
  submissionId String?          @unique @db.Uuid
  createdAt    DateTime         @default(now())

  topic      Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author     User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  moderationLogs ModerationLog[]

  @@index([topicId, status, createdAt])
  @@index([status, createdAt])
}

model Submission {
  id            String           @id @default(uuid()) @db.Uuid
  status        ModerationStatus @default(PENDING)
  topicId       String           @unique @db.Uuid
  submittedById String?          @db.Uuid
  createdAt     DateTime         @default(now())
  decidedAt     DateTime?

  topic       Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  submittedBy User? @relation(fields: [submittedById], references: [id], onDelete: SetNull)

  firstComment   Comment?
  moderationLogs ModerationLog[]

  @@index([status, createdAt])
  @@index([submittedById])
}

model ModerationLog {
  id           String           @id @default(uuid()) @db.Uuid
  action       ModerationAction
  reason       String?
  adminId      String?          @db.Uuid
  submissionId String?          @db.Uuid
  topicId      String?          @db.Uuid
  commentId    String?          @db.Uuid
  createdAt    DateTime         @default(now())

  admin      User?       @relation(fields: [adminId], references: [id], onDelete: SetNull)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  topic      Topic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  comment    Comment?    @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([submissionId])
  @@index([topicId])
  @@index([commentId])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

/**
 * Canonical topic-type taxonomy. One row per distinct Persian label.
 *
 * A topic attaches to these through TopicTypeTag, so a topic can carry
 * multiple types (one PRIMARY, the rest SECONDARY). The `status` field
 * governs pool membership:
 *   - APPROVED  -> offered by the add-topic autocomplete
 *   - PENDING   -> a label a user entered; awaiting admin review
 *   - REJECTED  -> reviewed and declined
 * A topic may reference a PENDING row — the user's custom label is attached
 * immediately and only the autocomplete eligibility waits for approval.
 *
 * FUTURE: synonym & hierarchy support.
 * `parentId` already models a "type -> more specific type" hierarchy
 * (e.g. «مکانیکی» -> «مکانیکی خودرو» -> «تعمیرگاه خودرو»). To add synonyms
 * later, introduce a TopicTypeSynonym table (or a canonicalId self-reference)
 * mapping alias labels to a canonical type — purely additive, no redesign.
 */
model TopicTypeSuggestion {
  id          String           @id @default(uuid()) @db.Uuid
  label       String           @unique
  status      ModerationStatus @default(PENDING)
  parentId    String?          @db.Uuid
  parent      TopicTypeSuggestion? @relation("TypeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    TopicTypeSuggestion[] @relation("TypeHierarchy")
  submittedAt DateTime         @default(now())
  decidedAt   DateTime?

  tags TopicTypeTag[]

  @@index([status, submittedAt])
  @@index([label])
  @@index([parentId])
}

/**
 * A type attached to a topic. Every topic has exactly one PRIMARY tag
 * (ordered first) and up to `TopicTypeTag`-count secondary tags.
 */
model TopicTypeTag {
  id      String         @id @default(uuid()) @db.Uuid
  topicId String         @db.Uuid
  typeId  String         @db.Uuid
  kind    TopicTypeKind  @default(SECONDARY)
  order   Int            @default(0)

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type  TopicTypeSuggestion @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@unique([topicId, typeId])
  @@index([topicId])
  @@index([typeId])
  @@index([typeId, kind])
}

/**
 * A repeatable contact / social-media row on a page (e.g. a phone number, an
 * Instagram account, a website, ...). One row per platform+value, so pages can
 * support an unlimited number of contact methods. `label` gives a phone (or
 * any contact) a human name such as «دفتر مرکزی», «فکس» or «علی».
 */
model TopicLink {
  id        String          @id @default(uuid()) @db.Uuid
  topicId   String          @db.Uuid
  platform  ContactPlatform
  label     String?
  value     String
  createdAt DateTime        @default(now())

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}
